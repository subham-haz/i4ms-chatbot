# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- pgvector ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=ragdb
COLLECTION_NAME=i4ms_policy
I4MS_DB_PATH=data/i4ms.db

# --- Retrieval ---
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5
RERANK_TOP_N=3
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
